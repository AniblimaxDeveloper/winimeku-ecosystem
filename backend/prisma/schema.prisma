generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_EDITOR
  MODERATOR
  USER
}

enum AnimeStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchHistory  WatchHistory[]
  watchlists    Watchlist[]
}

model Anime {
  id            String    @id @default(uuid())
  title         String
  synopsis      String?
  coverImage    String?
  status        AnimeStatus @default(ONGOING)
  releaseYear   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  episodes      Episode[]
  genres        Genre[]   @relation("AnimeGenres")
}

model Episode {
  id            String    @id @default(uuid())
  animeId       String
  episodeNumber Int
  title         String?
  videoUrl      String
  createdAt     DateTime  @default(now())

  anime         Anime     @relation(fields: [animeId], references: [id])
}

model Genre {
  id            String    @id @default(uuid())
  name          String    @unique
  animes        Anime[]   @relation("AnimeGenres")
}

model WatchHistory {
  id            String    @id @default(uuid())
  userId        String
  episodeId     String
  progress      Float     @default(0)
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
}

model Watchlist {
  id            String    @id @default(uuid())
  userId        String
  animeId       String
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
}
